  "messages": [
    {
      "from": "user",
      "to": "gw",
      "label": "ask a question",
      "desc": "The request carries an Identity Platform token."
    },
    {
      "from": "gw",
      "to": "agent",
      "label": "validated request"
    },
    {
      "from": "agent",
      "to": "armor",
      "label": "screen prompt"
    },
    {
      "from": "armor",
      "to": "agent",
