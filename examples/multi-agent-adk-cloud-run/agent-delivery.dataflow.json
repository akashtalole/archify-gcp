          "label": "Inventory agent service",
          "sublabel": "Cloud Run, A2A"
        },
        {
          "id": "s",
          "icon": "cloud-run",
          "label": "Shipping agent service",
          "sublabel": "Cloud Run, A2A"
        }
      ]
    },
    {
      "id": "observe_stage",
      "label": "Observe",
