          "icon": "artifact-registry",
          "label": "Artifact Registry",
          "sublabel": "one image per agent"
        }
      ]
    },
    {
      "id": "deploy_stage",
      "label": "Deploy",
      "items": [
        {
          "id": "deployp",
          "icon": "cloud-deploy",
          "label": "Cloud Deploy",
