  "edges": [
    {
      "from": "users",
      "to": "idp",
      "style": "dashed",
      "label": "sign in"
    },
    {
      "from": "users",
      "to": "ui",
      "step": 1,
      "label": "chat",
      "desc": "An operator asks a question in the chat UI; Identity-Aware Proxy authenticates the user"
    },
    {
      "from": "ui",
      "to": "root",
      "step": 2,
      "label": "run (session)",
      "desc": "The UI calls the coordinator's ADK API server with the user's session id; Cloud Run requires an ID token (roles/run.invoker)"
    },
    {
      "from": "root",
      "to": "plan",
      "step": 3,
      "label": "transfer",
      "desc": "The coordinator delegates planning and summarising to local sub-agents running in the same process"
    },
    {
      "from": "root",
      "to": "armor",
      "step": 4,
      "label": "screen"
    },
    {
      "from": "armor",
      "to": "gemini",
      "step": 5,
      "label": "safe prompt",
      "desc": "Prompts that pass Model Armor go to Gemini on Vertex AI; the agent chooses tools or sub-agents from the model's reply"
    },
    {
      "from": "root",
      "to": "inva",
      "step": 6,
      "label": "A2A",
      "desc": "The coordinator calls the remote inventory agent over the A2A protocol (RemoteA2aAgent), authenticating with a Google ID token"
    },
    {
      "from": "root",
      "to": "shipa",
      "step": 6,
      "label": "A2A"
    },
    {
      "from": "inva",
      "to": "toolbox",
      "step": 7,
      "label": "MCP tool call",
      "desc": "Specialist agents reach the database only through MCP Toolbox, which holds the connection and the allowed queries"
    },
    {
      "from": "shipa",
      "to": "toolbox",
      "step": 7
    },
    {
      "from": "toolbox",
      "to": "db",
      "step": 8,
      "label": "SQL"
    },
    {
      "from": "toolbox",
      "to": "sm",
      "style": "dashed",
      "label": "secrets"
    },
    {
      "from": "root",
      "to": "write",
      "step": 3
    },
    {
      "from": "toolbox",
      "to": "trace",
      "style": "dashed",
      "label": "spans"
    }
  ]
